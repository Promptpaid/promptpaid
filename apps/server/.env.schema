# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# Resend API key used for the waitlist confirmation email
# @sensitive @type=string(startsWith=re_)
RESEND_API_KEY=

# Sender for outgoing mail, format: "Name <address>"
EMAIL_FROM=

# Payment provider adapter to use. Only "fake" exists today; the fake
# adapter is development-only and the server refuses to boot with it
# anywhere else. Shared constants list valid values (PAYMENT_PROVIDERS).
# @public @required=false @type=enum(fake)
PAYMENT_PROVIDER=

# Development-only signing key the FAKE provider uses to authenticate
# simulated notifications (the dev script signs payloads with it). The
# adapter is refused outside development, so this never matters elsewhere.
# Sensitive like every secret; never printed or committed.
# @internal @required=false
PAYMENT_FAKE_WEBHOOK_SECRET=

# Telegram bot token (from BotFather). Sensitive; never printed or logged.
# @sensitive @required=false
TELEGRAM_BOT_TOKEN=

# Secret token Telegram echoes in the X-Telegram-Bot-Api-Secret-Token header
# on every webhook request. Requests without a matching header are rejected,
# and an unset value fails closed (the webhook route accepts nothing).
# Sensitive; never printed or committed.
# @sensitive @required=false
TELEGRAM_WEBHOOK_SECRET=

# @type=string(minLength=1)
DATABASE_URL=

# Hosts the dev-only `dev-set-status` seed script is allowed to write to
# (comma-separated). Leave empty to make the script refuse to run.
# @internal @required=false
DEV_SEED_ALLOWED_HOSTS=

# Database names the dev-only scripts (`dev-set-status`, `dev:load-questions`,
# `dev:clear-questions`) are allowed to write to (comma-separated).
# Leave empty to make the scripts refuse to run. Set values only in `.env`,
# never commit them.
# @internal @required=false
DEV_SEED_ALLOWED_DATABASES=
