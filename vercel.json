{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm run db:generate && cd apps/web && NEXT_PUBLIC_SERVER_URL=/api pnpm run build"
    },
    "server": {
      "root": "apps/server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm run db:generate && cd apps/server && pnpm run env:generate && pnpm run check-types",
      "functions": {
        "src/index.ts": {
          "includeFiles": "{package.json,apps/server/.env.schema,node_modules/.bin/varlock,node_modules/varlock/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
