generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String   @unique
  country        String
  languages      String[]
  interests      String[]
  consentAt      DateTime
  consentVersion String
  createdAt      DateTime @default(now())
  confirmationSentAt DateTime?
}